```
# Dependencies
node_modules/

# Build outputs
dist/
build/
coverage/

# Environment variables
.env
.env.local
.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Python cache (if any Python files exist in frontend)
__pycache__/
*.pyc
*.pyo

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp

# Coverage reports
htmlcov/
.coverage

# Package manager caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite build artifacts
!.gitignore
```